APP_ENV=local
APP_NAME=backend-belajar-lintas-ronald
HTTP_PORT=8000

# CORS allowed origins (comma-separated). Wildcards supported per Echo
# middleware (e.g. "https://*.preview.squantumengine.com"). Leave empty
# to disable CORS entirely. AllowCredentials defaults to true, so origins
# must be enumerated (cannot be "*").
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Persistence adapter at runtime. Must match a selected persistence axis option
# (postgres/mysql/mongodb). Fail-fast at startup if unrecognised.
PERSISTENCE_BACKEND=postgres

# boilerplate:axis=persistence option=postgres START
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=disable
# boilerplate:axis=persistence option=postgres END

# boilerplate:axis=persistence option=mysql START
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
# boilerplate:axis=persistence option=mysql END

# boilerplate:axis=persistence option=mongodb START
MONGODB_URI=
MONGODB_DB=
# boilerplate:axis=persistence option=mongodb END

# Cache adapter at runtime. Must match the selected cache axis option
# (redis/inmemory/noop). Fail-fast at startup if unrecognised.
CACHE_BACKEND=inmemory

# boilerplate:axis=cache option=redis START
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# boilerplate:axis=cache option=redis END

# boilerplate:axis=auth option=jwt START
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# JWT auth (HS256). Secret must be 32+ chars for production-like security.
JWT_ACCESS_TTL_SEC=3600
JWT_REFRESH_TTL_SEC=86400
# boilerplate:axis=auth option=jwt END

# boilerplate:axis=auth option=apikey START
API_KEY_HEADER=X-API-Key
API_KEYS=
# boilerplate:axis=auth option=apikey END

# boilerplate:axis=auth option=oauth2-oidc START
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# boilerplate:axis=auth option=oauth2-oidc END

# Observability backend selector: otel | datadog | noop
OBSERVABILITY_BACKEND=noop

# boilerplate:axis=observability option=otel START
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=backend-belajar-lintas-ronald
OTEL_EXPORTER_OTLP_INSECURE=false
# boilerplate:axis=observability option=otel END

# boilerplate:axis=observability option=datadog START
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=8126
DD_SERVICE=backend-belajar-lintas-ronald
DD_ENV=local
DD_TRACE_ENABLED=false
# boilerplate:axis=observability option=datadog END

# boilerplate:axis=messaging option=gcp-pubsub START
GCP_PROJECT_ID=
PUBSUB_TOPIC=
# boilerplate:axis=messaging option=gcp-pubsub END

# boilerplate:axis=messaging option=rabbitmq START
RABBITMQ_URL=
# boilerplate:axis=messaging option=rabbitmq END

# boilerplate:axis=messaging option=aws-sqs START
AWS_REGION=
SQS_QUEUE_URL=
# boilerplate:axis=messaging option=aws-sqs END

# boilerplate:axis=messaging option=aws-sns START
SNS_TOPIC_ARN=
# boilerplate:axis=messaging option=aws-sns END

# Storage adapter to use at runtime. Must match one of the selected
# storage axis options. Fail-fast at startup if unrecognised.
STORAGE_BACKEND=

# boilerplate:axis=storage option=gcs START
GCS_BUCKET=
# boilerplate:axis=storage option=gcs END

# boilerplate:axis=storage option=s3 START
S3_BUCKET=
# boilerplate:axis=storage option=s3 END

# boilerplate:axis=storage option=minio START
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
# boilerplate:axis=storage option=minio END

# boilerplate:axis=storage option=local START
LOCAL_STORAGE_PATH=./tmp/storage
# boilerplate:axis=storage option=local END

# boilerplate:axis=secrets option=gcp START
# GCP_PROJECT_ID already declared above (shared)
# boilerplate:axis=secrets option=gcp END

# boilerplate:axis=secrets option=aws START
# AWS_REGION already declared above (shared)
# boilerplate:axis=secrets option=aws END

# boilerplate:axis=secrets option=vault START
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_PATH=secret/data
# boilerplate:axis=secrets option=vault END

# boilerplate:axis=notification option=smtp START
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# boilerplate:axis=notification option=smtp END

# boilerplate:axis=notification option=sendgrid START
SENDGRID_API_KEY=
SENDGRID_FROM=
# boilerplate:axis=notification option=sendgrid END

# boilerplate:axis=rpc option=grpc START
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
# boilerplate:axis=rpc option=grpc END

# Inference adapter at runtime. Options: noop | onnxruntime.
# noop returns zero-value predictions; onnxruntime loads a model from
# INFERENCE_MODEL_DIR. Fail-fast at startup if unrecognised.
INFERENCE_BACKEND=noop
# Filesystem path where ONNX model files are mounted (used by onnxruntime adapter).
INFERENCE_MODEL_DIR=/models
