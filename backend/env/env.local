APP_ENV=local
APP_NAME=backend-belajar-lintas-ronald
HTTP_PORT=8000

CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template_be_go
POSTGRES_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_DB=0

JWT_SECRET=dev-only-secret-do-not-use-in-prod-32-chars
# Issuer + Audience checks intentionally disabled in local: the in-tree
# TokenIssuer (adapter/token/jwt) does not yet propagate these claims when
# signing. Verifier (adapter/auth/jwt) skips the check when these are empty.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SEC=3600
JWT_REFRESH_TTL_SEC=86400

OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_SERVICE_NAME=backend-belajar-lintas-ronald
OTEL_EXPORTER_OTLP_INSECURE=true

STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dev-bucket
MINIO_USE_SSL=false

# Inference adapter (noop|onnxruntime)
INFERENCE_BACKEND=noop
INFERENCE_MODEL_DIR=/models
