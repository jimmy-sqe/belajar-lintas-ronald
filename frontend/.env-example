# --- Build-time: Docker image build only ------------------------------------
# These vars are passed as Dockerfile ARGs and baked into the browser bundle
# by `next build`. Changes require a full `docker compose build`.
# Compose interpolates ${VAR} from this file into compose.yml build.args.
#
# Setup once per clone (compose auto-loads ".env" next to compose.yml; we
# point it at this file via a tracked-as-ignored symlink so a single .env
# serves both Next.js runtime and compose build-arg interpolation):
#
#   cp nextjs/.env-example nextjs/.env  # then fill in HORIZON_KEY
#   ln -s nextjs/.env .env              # at repo root
#
# Both .env files are gitignored. The symlink itself is also covered by
# the root .gitignore "/.env" rule.

# npm auth token for the private @squantumengine/* scope on registry.npmjs.org.
# Written to a transient .npmrc in the deps stage and deleted after install,
# so it never leaks into the runner image.
HORIZON_KEY=

NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_RENDERING_MODE=ssr
NEXT_PUBLIC_APP_NAME=TodoApp Preview-Env
# boilerplate:axis=mocking option=msw START
NEXT_PUBLIC_API_MOCKING=disabled
# boilerplate:axis=mocking option=msw END
# boilerplate:axis=rendering option=csr START
# CSR-only: Encryption key for localStorage (optional, falls back to default in dev)
NEXT_PUBLIC_ENCRYPTION_KEY=dev-only-encryption-key-do-not-use-in-prod-32+
# boilerplate:axis=rendering option=csr END
# boilerplate:axis=auth option=jwt-refresh START
NEXT_PUBLIC_ENABLE_REFRESH_TOKEN=false
# boilerplate:axis=auth option=jwt-refresh END
# boilerplate:axis=observability option=aws-rum START
NEXT_PUBLIC_RUM_APP_ID=
NEXT_PUBLIC_RUM_REGION=
NEXT_PUBLIC_RUM_IDENTITY_POOL_ID=
NEXT_PUBLIC_RUM_ENDPOINT=
# boilerplate:axis=observability option=aws-rum END
# boilerplate:axis=observability option=sentry START
NEXT_PUBLIC_SENTRY_DSN=
# boilerplate:axis=observability option=sentry END
# boilerplate:axis=observability option=otel START
# Service name reported by @vercel/otel (read in observability/otel/register.ts).
NEXT_PUBLIC_OTEL_SERVICE_NAME=frontend-belajar-lintas-ronald
# OTLP collector endpoint; @vercel/otel reads this from the environment automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=
# boilerplate:axis=observability option=otel END

# --- Runtime: server-side only ----------------------------------------------
# Read by the Node.js server at container start. Changes only need
# `docker compose restart`, not a full rebuild. Never sent to the browser.

# OpenAPI spec source for Kubb codegen (local path or remote URL).
NEXT_OPENAPI_URL=
NEXT_OPENAPI_USERNAME=
NEXT_OPENAPI_PASSWORD=
# boilerplate:axis=rendering option=ssr START
# SSR-only: 32-char secret for cookie encryption
AUTH_COOKIE_SECRET=dev-only-cookie-secret-32char!!!
# boilerplate:axis=rendering option=ssr END
# Auth cookie signing secret (required, min 32 characters)
AUTH_COOKIE_SECURE=your-32-char-cookie-secret-here
