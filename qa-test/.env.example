# =============================================================================
# Environment configuration for belajar-lintas-ronald
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
#   cp .env.example .env
#
# The .env file is gitignored. Only .env.example is committed.
# =============================================================================


# -----------------------------------------------------------------------------
# Target application under test
# -----------------------------------------------------------------------------
# BASE_URL is the host the Playwright browser + API client point at.
BASE_URL=https://staging.example.com
TEST_USERNAME=your.user@example.com
TEST_PASSWORD=change-me

# Default browser viewport (WIDTHxHEIGHT). Override per-test with
# @pytest.mark.viewport(width, height).
VIEWPORT=1440x900


# boilerplate:axis=sample-suite option=general-service START
# -----------------------------------------------------------------------------
# Project (belajar_lintas_ronald) overrides — optional.
# Set these only if this project runs on a different host/credentials than
# the BASE_URL above.
# -----------------------------------------------------------------------------
# BELAJAR_LINTAS_RONALD_BASE_URL=https://belajar-lintas-ronald-staging.example.com
# BELAJAR_LINTAS_RONALD_TEST_USERNAME=qa.user@example.com
# BELAJAR_LINTAS_RONALD_TEST_PASSWORD=change-me
# BELAJAR_LINTAS_RONALD_VIEWPORT=1920x1080
# boilerplate:axis=sample-suite option=general-service END
